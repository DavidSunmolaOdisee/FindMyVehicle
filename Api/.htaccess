RewriteEngine On
RewriteRule ^users/?$ users.php [L,NC]
RewriteRule ^users/(.*)$ users.php [L,NC]     # <-- zodat /users/login en /users/change_password werken
RewriteRule ^vehicles/?$ vehicles.php [L,NC]
RewriteRule ^parkings/?$ parkings.php [L,NC]
RewriteRule ^parkings/close/?$ parkings.php [L,NC]
